# ==========================================================================
# IBRAHIM VIP ZONE — Production Environment Variables
# Copy to `.env` locally, or set in Render dashboard (one var per line).
# NEVER commit real secrets — `.env`, `.env.local`, `.env.production` are
# all git-ignored.
# ==========================================================================

# --- PostgreSQL (REQUIRED) ------------------------------------------------
# On Render this is the "Internal Database URL" from your Postgres service
# (automatically injected as DATABASE_URL). For local dev use 127.0.0.1.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Admin account (REQUIRED — used only on first seed) ------------------
ADMIN_EMAIL=admin@ibrahimvipzone.com
ADMIN_PASSWORD=ChangeMeStrongPassword123
ADMIN_NAME=IBRAHIM
ADMIN_PHONE=+8800000000000

# --- Session/HTTPS (REQUIRED in production) ------------------------------
# Render serves HTTPS, so the secure session cookie must be enabled.
COOKIE_SECURE=true

# --- AI Assistant (optional) ---------------------------------------------
# WITHOUT a key, the built-in multilingual rule engine answers everything.
# WITH a key, OpenAI handles conversational intents (critical answers stay
# rule-grounded). Keys are read ONLY server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# (Optional) custom OpenAI-compatible endpoint overrides
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
